@{
    ViewData["Title"] = "Home Page";
}
<div class="control-section">
    <!-- Main Document Editor Area -->
    <div class="editor-container">
        <ejs-documenteditorcontainer id="container" toolbarMode="Ribbon" serviceUrl="/api/DocumentEditor/" 
            enableToolbar=true created="onCreated" class="editor-wrapper">
        <ejs-documentEditorSettings optimizeSfdt= "false"> 
        </ejs-documentEditorSettings></ejs-documenteditorcontainer>
    </div>

    <!-- Right Side Panel with Indicators Table -->
    <div id="indicatorPanel" class="indicator-panel">
        <!-- Indicator Table Section -->
        <div class="panel-section">
            <h3>ADD INDICATOR</h3>
            <p class="panel-hint">You can edit and add indicators here</p>

            <!-- Indicator Table -->
            <div class="table-container">
                <table id="indicatorTable" class="indicator-table">
                    <thead>
                        <tr>
                            <th data-column="indicator">Indicators</th>
                            <th data-column="year2023">2023</th>
                            <th data-column="year2024">2024</th>
                            <th data-column="year2025">2025</th>
                            <th data-column="target2026">Target 2026</th>
                            <th data-column="unit">Unit</th>
                            <th data-column="actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr data-rowindex="0">
                            <td>Total Waste</td>
                            <td>18064.0</td>
                            <td>18088.0</td>
                            <td>2037.0</td>
                            <td>22068.0</td>
                            <td>kg</td>
                            <td class="actions-cell">
                                <button class="btn-action btn-edit" onclick="editRow(0)" title="Edit">✎</button>
                                <button class="btn-action btn-delete" onclick="deleteRow(0)" title="Delete">🗑</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Add Indicator Button -->
            <button class="btn-add-indicator" onclick="showAddIndicatorDialog()">
                <span style="margin-right: 5px;">+</span> Add another indicator to this table
            </button>
        </div>

        <!-- Table Settings Section -->
        <div class="panel-section">
            <h4>Table Settings</h4>
            
            <div class="settings-group">
                <label class="setting-label">Show Hide Columns</label>
                <div class="checkbox-list">
                    <label class="checkbox-item">
                        <input type="checkbox" class="column-checkbox" data-column="indicator" checked> Indicator
                    </label>
                    <label class="checkbox-item">
                        <input type="checkbox" class="column-checkbox" data-column="year2023" checked> 2023
                    </label>
                    <label class="checkbox-item">
                        <input type="checkbox" class="column-checkbox" data-column="year2024" checked> 2024
                    </label>
                    <label class="checkbox-item">
                        <input type="checkbox" class="column-checkbox" data-column="year2025" checked> 2025
                    </label>
                    <label class="checkbox-item">
                        <input type="checkbox" class="column-checkbox" data-column="target2026" checked> Target 2026
                    </label>
                    <label class="checkbox-item">
                        <input type="checkbox" class="column-checkbox" data-column="unit" checked> Unit
                    </label>
                </div>
            </div>
        </div>

        <!-- Add Button -->
        <div class="panel-section" style="padding-top: 10px;">
            <button class="btn-export" onclick="exportAndInsertTable()" id="addTableBtn" title="Export and insert as HTML">
                <span style="margin-right: 5px;">+</span> Add
            </button>
        </div>
    </div>
</div>

<!-- Spinner Overlay (centered on editor) -->
<div id="spinner" class="spinner-overlay" style="display: none;">
    <div class="spinner-loader"></div>
</div>

<!-- Add Indicator Dialog -->
<div id="addIndicatorDialog" class="modal" style="display: none;">
    <div class="modal-content">
        <span class="close" onclick="closeAddIndicatorDialog()">&times;</span>
        <h2>Add New Indicator</h2>
        
        <div class="form-group">
            <label for="indicatorName">Indicator:</label>
            <input type="text" id="indicatorName" placeholder="Enter indicator name">
        </div>

        <div class="form-group">
            <label for="indicatorYear2023">2023:</label>
            <input type="number" id="indicatorYear2023" placeholder="Enter value">
        </div>

        <div class="form-group">
            <label for="indicatorYear2024">2024:</label>
            <input type="number" id="indicatorYear2024" placeholder="Enter value">
        </div>

        <div class="form-group">
            <label for="indicatorYear2025">2025:</label>
            <input type="number" id="indicatorYear2025" placeholder="Enter value">
        </div>

        <div class="form-group">
            <label for="indicatorTarget2026">Target 2026:</label>
            <input type="number" id="indicatorTarget2026" placeholder="Enter value">
        </div>

        <div class="form-group">
            <label for="indicatorUnit">Unit:</label>
            <input type="text" id="indicatorUnit" placeholder="Enter unit (e.g., kg)">
        </div>

        <div class="form-actions">
            <button class="btn-cancel" onclick="closeAddIndicatorDialog()">Cancel</button>
            <button class="btn-add" onclick="addIndicatorRow()">Add</button>
        </div>
    </div>
</div>

<!-- Edit Indicator Dialog -->
<div id="editIndicatorDialog" class="modal" style="display: none;">
    <div class="modal-content">
        <span class="close" onclick="closeEditIndicatorDialog()">&times;</span>
        <h2>Edit Indicator</h2>
        
        <div class="form-group">
            <label for="editIndicatorName">Indicator:</label>
            <input type="text" id="editIndicatorName" placeholder="Enter indicator name">
        </div>

        <div class="form-group">
            <label for="editIndicatorYear2023">2023:</label>
            <input type="number" id="editIndicatorYear2023" placeholder="Enter value">
        </div>

        <div class="form-group">
            <label for="editIndicatorYear2024">2024:</label>
            <input type="number" id="editIndicatorYear2024" placeholder="Enter value">
        </div>

        <div class="form-group">
            <label for="editIndicatorYear2025">2025:</label>
            <input type="number" id="editIndicatorYear2025" placeholder="Enter value">
        </div>

        <div class="form-group">
            <label for="editIndicatorTarget2026">Target 2026:</label>
            <input type="number" id="editIndicatorTarget2026" placeholder="Enter value">
        </div>

        <div class="form-group">
            <label for="editIndicatorUnit">Unit:</label>
            <input type="text" id="editIndicatorUnit" placeholder="Enter unit (e.g., kg)">
        </div>

        <div class="form-actions">
            <button class="btn-cancel" onclick="closeEditIndicatorDialog()">Cancel</button>
            <button class="btn-add" onclick="updateIndicatorRow()">Update</button>
        </div>
    </div>
</div>
<script>
    ej.documenteditor.DocumentEditorContainer.Inject(ej.documenteditor.Toolbar, ej.documenteditor.Ribbon);
    var documenteditor;
    var container;

    function onCreated() {
        var documenteditorElement = document.getElementById("container");
        container = documenteditorElement.ej2_instances[0];
        documenteditor = container.documentEditor;

           var defaultDocument = {"sfdt":""};
             documenteditor.open(JSON.stringify(defaultDocument));


    }

    // ==================== Global Variables ====================
    var currentEditRowIndex = -1;

    // ==================== Add Indicator Dialog Functions ====================
    function showAddIndicatorDialog() {
        document.getElementById("addIndicatorDialog").style.display = "block";
        // Clear form fields
        document.getElementById("indicatorName").value = "";
        document.getElementById("indicatorYear2023").value = "";
        document.getElementById("indicatorYear2024").value = "";
        document.getElementById("indicatorYear2025").value = "";
        document.getElementById("indicatorTarget2026").value = "";
        document.getElementById("indicatorUnit").value = "";
        document.getElementById("indicatorName").focus();
    }

    function closeAddIndicatorDialog() {
        document.getElementById("addIndicatorDialog").style.display = "none";
    }

    function addIndicatorRow() {
        // Get form values
        const name = document.getElementById("indicatorName").value;
        const year2023 = document.getElementById("indicatorYear2023").value;
        const year2024 = document.getElementById("indicatorYear2024").value;
        const year2025 = document.getElementById("indicatorYear2025").value;
        const target2026 = document.getElementById("indicatorTarget2026").value;
        const unit = document.getElementById("indicatorUnit").value;

        // Validation
        if (!name.trim() || !year2023 || !year2024 || !year2025 || !target2026 || !unit.trim()) {
            alert("Please fill in all fields");
            return;
        }

        // Get the current row index for new row
        const table = document.getElementById("indicatorTable");
        const tbody = table.querySelector("tbody");
        const rowIndex = tbody.rows.length;

        // Create new row
        const newRow = tbody.insertRow();
        newRow.setAttribute("data-rowindex", rowIndex);
        newRow.innerHTML = `
            <td>${escapeHtml(name)}</td>
            <td>${year2023}</td>
            <td>${year2024}</td>
            <td>${year2025}</td>
            <td>${target2026}</td>
            <td>${escapeHtml(unit)}</td>
            <td class="actions-cell">
                <button class="btn-action btn-edit" onclick="editRow(${rowIndex})" title="Edit">✎</button>
                <button class="btn-action btn-delete" onclick="deleteRow(${rowIndex})" title="Delete">🗑</button>
            </td>
        `;

        // Close dialog
        closeAddIndicatorDialog();
    }

    // ==================== Edit Indicator Dialog Functions ====================
    function editRow(rowIndex) {
        const table = document.getElementById("indicatorTable");
        const tbody = table.querySelector("tbody");
        const row = tbody.rows[rowIndex];

        if (!row) {
            alert("Row not found");
            return;
        }

        // Store the row index for update
        currentEditRowIndex = rowIndex;

        // Populate form fields
        const cells = row.querySelectorAll("td");
        document.getElementById("editIndicatorName").value = cells[0].textContent;
        document.getElementById("editIndicatorYear2023").value = cells[1].textContent;
        document.getElementById("editIndicatorYear2024").value = cells[2].textContent;
        document.getElementById("editIndicatorYear2025").value = cells[3].textContent;
        document.getElementById("editIndicatorTarget2026").value = cells[4].textContent;
        document.getElementById("editIndicatorUnit").value = cells[5].textContent;

        // Show dialog
        document.getElementById("editIndicatorDialog").style.display = "block";
        document.getElementById("editIndicatorName").focus();
    }

    function closeEditIndicatorDialog() {
        document.getElementById("editIndicatorDialog").style.display = "none";
        currentEditRowIndex = -1;
    }

    function updateIndicatorRow() {
        // Get form values
        const name = document.getElementById("editIndicatorName").value;
        const year2023 = document.getElementById("editIndicatorYear2023").value;
        const year2024 = document.getElementById("editIndicatorYear2024").value;
        const year2025 = document.getElementById("editIndicatorYear2025").value;
        const target2026 = document.getElementById("editIndicatorTarget2026").value;
        const unit = document.getElementById("editIndicatorUnit").value;

        // Validation
        if (!name.trim() || !year2023 || !year2024 || !year2025 || !target2026 || !unit.trim()) {
            alert("Please fill in all fields");
            return;
        }

        // Update row
        const table = document.getElementById("indicatorTable");
        const tbody = table.querySelector("tbody");
        const row = tbody.rows[currentEditRowIndex];

        if (!row) {
            alert("Row not found");
            return;
        }

        // Update cells
        const cells = row.querySelectorAll("td");
        cells[0].textContent = name;
        cells[1].textContent = year2023;
        cells[2].textContent = year2024;
        cells[3].textContent = year2025;
        cells[4].textContent = target2026;
        cells[5].textContent = unit;

        // Close dialog
        closeEditIndicatorDialog();
    }

    // ==================== Delete Row Function ====================
    function deleteRow(rowIndex) {
        if (confirm("Are you sure you want to delete this indicator?")) {
            const table = document.getElementById("indicatorTable");
            const tbody = table.querySelector("tbody");
            
            if (tbody.rows.length <= 1) {
                alert("Cannot delete the last row. Please keep at least one indicator.");
                return;
            }

            tbody.deleteRow(rowIndex);

            // Re-index all rows
            const rows = tbody.querySelectorAll("tr");
            rows.forEach((row, index) => {
                row.setAttribute("data-rowindex", index);
                const buttons = row.querySelectorAll(".btn-action");
                buttons[0].setAttribute("onclick", `editRow(${index})`);
                buttons[1].setAttribute("onclick", `deleteRow(${index})`);
            });
        }
    }

    // ==================== Helper Functions ====================
    function escapeHtml(text) {
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
    }



    // ==================== Export and Insert Functions ====================

       function applyExportStyles(clonedTable) {

        const rootStyles = getComputedStyle(document.documentElement);

        const headerBg = rootStyles.getPropertyValue('--table-header-bg').trim();
        const headerColor = rootStyles.getPropertyValue('--table-header-color').trim();
        const headerBorder = rootStyles.getPropertyValue('--table-header-border').trim();

        const cellBg = rootStyles.getPropertyValue('--table-cell-bg').trim();
        const cellColor = rootStyles.getPropertyValue('--table-cell-color').trim();
        const cellBorder = rootStyles.getPropertyValue('--table-cell-border').trim();

        const padding = rootStyles.getPropertyValue('--table-cell-padding').trim();
        const fontSize = rootStyles.getPropertyValue('--table-font-size').trim();
        const fontWeight = rootStyles.getPropertyValue('--table-header-font-weight').trim();

        // Table
        clonedTable.style.width = "100%";
        clonedTable.style.borderCollapse = "collapse";
        clonedTable.style.fontSize = fontSize;

        // Header cells
        clonedTable.querySelectorAll("th").forEach(th => {
            th.style.backgroundColor = headerBg;
            th.style.color = headerColor;
            th.style.border = `1px solid ${headerBorder}`;
            th.style.padding = padding;
            th.style.textAlign = "center";
            th.style.fontWeight = fontWeight;
        });

        // Data cells
        clonedTable.querySelectorAll("td").forEach(td => {
            td.style.backgroundColor = cellBg;
            td.style.color = cellColor;
            td.style.border = `1px solid ${cellBorder}`;
            td.style.padding = padding;
            td.style.textAlign = "center";
        });
    }

        function getVisibleColumnsTable() {
        const table = document.getElementById("indicatorTable");

        const checkboxes = document.querySelectorAll(".column-checkbox:checked");
        const visibleColumns = Array.from(checkboxes).map(cb => cb.dataset.column);
        // Clone table
        const clonedTable = table.cloneNode(true);
         applyExportStyles(clonedTable);
        // Remove hidden columns
        const headers = clonedTable.querySelectorAll("th");
        const columnsToRemove = [];

        headers.forEach((header, index) => {
            const columnType = header.dataset.column;

            if (!visibleColumns.includes(columnType) || columnType === "actions") {
                columnsToRemove.push(index);
            }
        });

        const rows = clonedTable.querySelectorAll("tr");

        rows.forEach(row => {
            const cells = row.querySelectorAll("th, td");

            for (let i = columnsToRemove.length - 1; i >= 0; i--) {
                if (cells[columnsToRemove[i]]) {
                    cells[columnsToRemove[i]].remove();
                }
            }
        });

        console.log(clonedTable.outerHTML);

        return clonedTable.outerHTML;
    }
        

    function exportAndInsertTable() {
        // Show spinner during export/insert
        const spinner = document.getElementById("spinner");
        if (spinner) {
            spinner.style.display = "block";
        }
        // Get the visible table as HTML
        const tableHtml = getVisibleColumnsTable(); 
        console.log(tableHtml);
        // Insert at cursor in document editor
        if (!documenteditor || !container) {
            alert("Document editor not initialized");
            return;
        }
        // convert HTML to SFDT format      
        let http = new XMLHttpRequest();
        http.open('POST', container.documentEditor.serviceUrl + 'LoadStringHtml');
        http.setRequestHeader('Content-Type', 'application/json;charset=UTF-8');
        http.responseType = 'text';

        // Handle the response when it comes back
        http.onload = function () {
            if (http.status === 200) {
                try {
                    // Server returns optimized SFDT (serialized WordDocument)
                    let sfdtResponse = http.response;
                    // Insert the table into the document at cursor position
                    container.documentEditor.editor.paste(sfdtResponse, 'KeepSourceFormatting');
                    if (spinner) {
                        spinner.style.display = "none";
                    }
                } catch (e) {
                    if (spinner) {
                        spinner.style.display = "none";
                    }
                    console.error('Error inserting table:', e);
                    alert("Error inserting table: " + e.message);
                }
            } else {
                if (spinner) {
                    spinner.style.display = "none";
                }
                console.error('Error from server:', http.status, http.response);
                alert("Error converting table to document format");
            }
        };

        http.onerror = function () {
            console.error('Request failed');
            alert("Request failed");
        };

        // Send the HTML content to server for conversion to SFDT
        let html = { HtmlContent: tableHtml };
        http.send(JSON.stringify(html));
    }

    // ==================== Initialize ====================
    document.addEventListener("DOMContentLoaded", function() {
        
        // Close modal when clicking outside
        window.onclick = function(event) {
            const addModal = document.getElementById("addIndicatorDialog");
            const editModal = document.getElementById("editIndicatorDialog");
            
            if (event.target === addModal) {
                addModal.style.display = "none";
            }
            if (event.target === editModal) {
                editModal.style.display = "none";
            }
        };

        // Allow Enter key to submit forms
        document.getElementById("indicatorName").addEventListener("keypress", function(e) {
            if (e.key === "Enter") {
                document.querySelector("#addIndicatorDialog .btn-add").click();
            }
        });

        document.getElementById("editIndicatorName").addEventListener("keypress", function(e) {
            if (e.key === "Enter") {
                document.querySelector("#editIndicatorDialog .btn-add").click();
            }
        });
    });

</script>