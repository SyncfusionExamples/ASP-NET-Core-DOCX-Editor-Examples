@{
    ViewData["Title"] = "Home Page";
}
@using Syncfusion.EJ2

<div id="Feature" class="table-action-bar">
    <button class="table-action-btn" onclick="alert('Info')">
        <span class="e-icons e-circle-info"></span>
    </button>

    <button class="table-action-btn" onclick="alert('Settings')">
        <span class="e-icons e-settings"></span>
    </button>

    <button class="table-action-btn" onclick="alert('More')">
        <span class="e-icons e-more-vertical-1"></span>
    </button>
</div>
<ejs-documenteditorcontainer id="container" serviceUrl="/api/DocumentEditor/" enableToolbar=true toolbarMode="Ribbon" height="90vh">

</ejs-documenteditorcontainer>

<script>
    ej.documenteditor.DocumentEditorContainer.Inject(ej.documenteditor.Toolbar, ej.documenteditor.Ribbon);
    var container;
    
    document.addEventListener('DOMContentLoaded', function () {
        container = document.getElementById("container").ej2_instances[0];
        var sfdt = {"sfdt":""};
        container.documentEditor.open(JSON.stringify(sfdt));
        container.documentEditor.selectionChange = function () {
            updateFeaturePosition();
        };

        container.documentEditor.viewChange = function () {
            updateFeaturePosition();
        };
    });
    function updateFeaturePosition() {

        if (!container || !container.documentEditor) {
            return;
        }

        var viewerContainer =
            document.querySelector('[id$="_viewerContainer"]');

        var featureElement =
            document.getElementById('Feature');

        if (!viewerContainer || !featureElement) {
            return;
        }

        if (featureElement.parentElement !== viewerContainer) {
            viewerContainer.appendChild(featureElement);
        }

        try {

            var position =
                container.documentEditor.selection.getTablePosition();

            if (!position ||
                (position.tableTopInCurrentPage === 0 &&
                    position.tableRightInCurrentPage === 0)) {

                featureElement.style.display = 'none';
                return;
            }

            featureElement.style.display = 'flex';

            featureElement.style.top =
                position.tableTopInCurrentPage + 'px';

            featureElement.style.left =
                (position.tableRightInCurrentPage + 12) + 'px';

        } catch (e) {

            featureElement.style.display = 'none';
        }
    }
</script>

<style>
    .table-action-bar {
        position: absolute;
        display: none;
        flex-direction: column;
        gap: 2px;
        z-index: 1000;
    }

    .table-action-btn {
        width: 20px;
        height: 20px;
        border: none;
        background: transparent;
        cursor: pointer;
        color: #5f6368;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .table-action-btn:hover {
        color: #1f1f1f;
    }
</style>