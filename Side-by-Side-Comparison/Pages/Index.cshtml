@page
@model IndexModel
@using Syncfusion.EJ2
@{
    ViewData["Title"] = "Side by Side Comparison - ASP.NET Core DOCX Editor";
}

<div class="content-container">
    <div class="control-section">
        <div style="width: 760px; margin: 10px auto">

            <!-- Files row -->
            <div style="display: flex; gap: 6px;">

                <!-- Original -->
                <div style="width: 360px; border-radius: 6px; padding: 14px; border: 1px dashed #ccc;">

                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span>Original document</span>

                        <label style="
                            padding: 4px 10px;
                            border: 1px solid #ccc;
                            border-radius: 4px;
                            cursor: pointer;">
                            Choose file
                            <input type="file"
                                   id="originalFileInput"
                                   accept=".docx,.sfdt"
                                   style="display: none;" />
                        </label>
                    </div>

                    <!-- Filename + Delete icon -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px; font-size: 12px; color: #666;">
                        <span id="originalFileName">Supported formats: SFDT, DOCX</span>
                        <span id="removeOriginalFile"
                              class="e-icons e-trash"
                              style="cursor: pointer;"
                              title="Remove file"></span>
                    </div>

                </div>

                <!-- Revised file -->
                <div style="width: 360px; border-radius: 6px; padding: 14px; border: 1px dashed #ccc;">

                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span>Revised document</span>

                        <label style="
                            padding: 4px 10px;
                            border: 1px solid #ccc;
                            border-radius: 4px;
                            cursor: pointer;">
                            Choose file
                            <input type="file"
                                   id="revisedFileInput"
                                   accept=".docx,.sfdt"
                                   style="display: none;" />
                        </label>
                    </div>

                    <!-- Filename + Delete icon -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px; font-size: 12px; color: #666;">
                        <span id="revisedFileName">Supported formats: SFDT, DOCX</span>
                        <span id="removeRevisedFile"
                              class="e-icons e-trash"
                              style="cursor: pointer;"
                              title="Remove file"></span>
                    </div>

                </div>

            </div>

            <!-- Checkbox, Compare & Download buttons -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">

                <!-- Checkbox -->
                <div>
                    <label>
                        <input type="checkbox"
                               id="showResultCheckbox"
                               checked />
                        Show comparison results with tracked changes
                    </label>
                </div>

                <div style="display: flex; gap: 10px;">
                    <ejs-button id="compareButton"
                                cssClass="e-primary"
                                content="Compare"
                                disabled="true">
                    </ejs-button>
                    <ejs-button id="downloadButton"
                                cssClass="e-outline e-primary"
                                content="Download"
                                iconCss="e-icons e-download"
                                disabled="true">
                    </ejs-button>
                </div>

            </div>

            <!-- Editors Area -->
            <div style="display: flex; gap: 6px; height: calc(100vh - 160px); padding: 0px 10px;">

                <!-- Left Editor -->
                <div style="width: 50%; display: flex; flex-direction: column; border: 1px solid #ddd; overflow: hidden;">

                    <div class="e-de-ctn-title" style="padding: 8px; font-weight: 600;">
                        Original Document
                    </div>

                    <div style="flex: 1; height: 100%;">
                        <ejs-documenteditorcontainer id="documentEditor1"
                                                     height="100%"
                                                     showPropertiesPane="false"
                                                     enableToolbar="false">
                        </ejs-documenteditorcontainer>
                    </div>

                </div>

                <!-- Right Editor -->
                <div style="width: 50%; display: flex; flex-direction: column; border: 1px solid #ddd; overflow: hidden;">

                    <div class="e-de-ctn-title" style="display: flex; justify-content: space-between; align-items: center">
                        <div style="float: left; padding: 8px; font-weight: 600; flex: 1;" id="rightEditorTitle">
                            Result Document (with tracked changes)
                        </div>
                        <button id="showRevisionsButton"
                            class="e-de-ctn-title"
                            iconCss="e-icons e-eye"
                            style="float: right; font-weight: 400; background: transparent; box-shadow: none; border-color: transparent; border-radius: 0px;
                                    color: inherit; font-size: 12px;"
                            title="Show/Hide Revisions Pane">
                            Show Review Pane
                        </button>
                    </div>

                    <div style="flex: 1; height: 100%;">
                        <ejs-documenteditorcontainer id="documentEditor2"
                                                     height="100%"
                                                     showPropertiesPane="false"
                                                     enableToolbar="false">
                        </ejs-documenteditorcontainer>
                    </div>

                </div>

            </div>

            <!-- Waiting Popup Overlay -->
            <div id="popup-overlay" class="overlay"></div>

            <div id="waiting-popup" style="display: none;">
                <svg class="circular" width="40" height="40">
                    <circle class="circle-path"
                            cx="25"
                            cy="25"
                            r="20"
                            fill="none"
                            stroke-width="6"
                            stroke-miterlimit="10" />
                </svg>
            </div>

        </div>
    </div>
</div>

<style>
    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(56, 56, 56, 0.5);
        z-index: 9999;
        display: none;
        cursor: not-allowed;
    }

    #waiting-popup {
        width: 56px;
        height: 56px;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        padding: 3px;
        background: white;
        box-shadow: 0px 3px 6px rgba(0,0,0,.3);
        z-index: 10000;
        display: none;
    }

    .circular {
        animation: rotate 2s linear infinite;
        height: 50px;
        width: 50px;
        border-radius: 50%;
    }

    .circle-path {
        stroke-dasharray: 1, 200;
        stroke-dashoffset: 0;
        animation: dash 1.5s ease-in-out infinite, color 6s ease-in-out infinite;
        stroke-linecap: round;
        stroke: #ff4081;
    }

    @@keyframes rotate {
        100% {
            transform: rotate(360deg);
        }
    }

    @@keyframes dash {
        0% {
            stroke-dasharray: 1, 200;
            stroke-dashoffset: 0;
        }

        50% {
            stroke-dasharray: 89, 200;
            stroke-dashoffset: -35;
        }

        100% {
            stroke-dasharray: 89, 200;
            stroke-dashoffset: -124;
        }
    }
</style>

@section Scripts{
<script src="~/js/compare-documents.js" asp-append-version="true"></script>
}
