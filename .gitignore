## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET build artifacts
*.dll
*.exe
*.pdb
*.cache

# Visual Studio / Rider / VS Code metadata
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
packages/
**/packages/*
!**/packages/build/

# Node
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*

# Publish output
[Pp]ublishOutput/
publish/

# Runtime data
*.log

# Client libraries (restored via libman / not needed in repo)
Side-by-Side-Comparison/wwwroot/lib/
**/wwwroot/lib/

# Build artifacts
bin/
obj/
node_modules/
package-lock.json
